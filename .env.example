# --- Pakolliset ---
DISCORD_TOKEN=           # Developer Portal → Bot → Reset Token
GUILD_ID=                # Discord-palvelimen ID (Developer Mode → oikea klikkaus palvelimeen → Copy Server ID)
ADMIN_PASSWORD=          # web-paneelin salasana, vähintään 10 merkkiä

# --- Suositellut ---
API_TOKEN=               # turnausjärjestelmälle: openssl rand -hex 24

# --- Minecraft (voi asettaa myös paneelista) ---
MC_HOST=
MC_PORT=25565
MC_RCON_PORT=25575
MC_RCON_PASSWORD=

# --- Valinnainen: Pterodactyl-servereiden käynnistys/sammutus paneelista ---
PTERO_URL=               # esim. https://panel.riilab.uk
PTERO_API_KEY=           # Account → API Credentials (ptlc_…)

# --- Muut ---
# WEB_PORT=8080          # Pterodactylissa käytetään automaattisesti SERVER_PORT
# SESSION_HOURS=12
# DATA_DIR=./data
